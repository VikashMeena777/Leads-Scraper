# ─── Google Sheets ──────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=config/credentials.json

# ─── Telegram Notifications ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Scraper Settings ───────────────────────
HEADLESS=true
MIN_DELAY=2
MAX_DELAY=5
MAX_RETRIES=3

# ─── Lead Mixer ─────────────────────────────
# Daily Mix tab is created automatically in the same Google Sheet
# No separate sheet ID needed — uses GOOGLE_SHEET_ID above
DAILY_MIX_BATCH_SIZE=50

# ─── Proxy (Optional) ───────────────────────
USE_PROXY=false
PROXY_URL=
